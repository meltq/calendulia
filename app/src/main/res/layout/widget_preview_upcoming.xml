<?xml version="1.0" encoding="utf-8"?>
<!-- Static mock shown in the widget picker (android:previewLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_widget_bg"
    android:orientation="vertical"
    android:padding="10dp"
    tools:ignore="HardcodedText">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7  Wednesday"
        android:textColor="@color/widget_preview_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView style="@style/WidgetPreviewEventRow" android:text="Stand-up\n9:30" />
    <TextView style="@style/WidgetPreviewEventRow" android:text="Lunch with Sam\n12:30" />
    <TextView style="@style/WidgetPreviewEventRow" android:text="Gym\nTomorrow · 18:00" />
</LinearLayout>
