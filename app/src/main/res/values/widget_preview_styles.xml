<?xml version="1.0" encoding="utf-8"?>
<!-- Shared looks for the static widget-picker previews. -->
<resources>
    <style name="WidgetPreviewWeekDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/widget_preview_on_surface</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="WidgetPreviewEventRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:background">@drawable/preview_widget_row_bg</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:textColor">@color/widget_preview_on_surface</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
